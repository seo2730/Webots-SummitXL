#VRML_SIM R2025a utf8
IMPORTABLE EXTERNPROTO "../protos/Mavic2ProMediumSensorized.proto"
IMPORTABLE EXTERNPROTO "../protos/SpotSensorized.proto"
IMPORTABLE EXTERNPROTO "../protos/SummitXlSteelSensorized.proto"
IMPORTABLE EXTERNPROTO "../protos/Mavic2ProMedium.proto"
# gen_world.py 가 생성한 월드 — 직접 고치지 말고 스크립트를 고쳐 다시 생성할 것.
#
# 외부 PROTO 의존이 없다. 바닥·벽·선반·기둥이 전부 plain Solid + Box 라서
# 컨트롤러도, 다운로드도, 월드 옆 캐시 디렉터리도 필요 없다.
# (Webots 샘플 월드들이 그 셋 때문에 계속 걸렸다 — gen_world.py 주석 참고)

WorldInfo {
  info [ "100x100 m 창고형 작전 지역 (gen_world.py 생성)" ]
  title "warehouse100"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.35 0.35 0.87 1.7
  position -35.0 -35.0 45.0
}
DirectionalLight {
  direction 0.3 -0.4 -1
  intensity 3
  castShadows FALSE
}
DirectionalLight {
  direction -0.5 0.3 -0.6
  intensity 1.5
}
Background {
  skyColor [ 0.62 0.68 0.74 ]
}
Solid {
  translation 0.000 0.000 -0.050
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.48
        roughness 0.9
        metalness 0
      }
      geometry Box {
        size 100.000 100.000 0.100
